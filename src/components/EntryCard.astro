---
interface Props {
  href: string;
  title: string;
  description: string;
  date?: Date;
}

const { href, title, description, date } = Astro.props;
const formatted = date?.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
---

<article>
  <h3><a href={href}>{title}</a></h3>
  {formatted && <time class="muted small" datetime={date?.toISOString()}>{formatted}</time>}
  <p>{description}</p>
</article>

<style>
  article {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }

  article:last-of-type {
    border-bottom: 0;
  }

  h3 {
    margin: 0 0 0.15rem;
  }

  h3 a {
    color: var(--fg);
  }

  h3 a:hover {
    color: var(--accent);
  }

  p {
    margin: 0.35rem 0 0;
    color: var(--muted);
  }
</style>
