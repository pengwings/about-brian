---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Unlock" noindex>
  <h1>This page is private</h1>
  <p class="muted">Enter the password to continue.</p>
  <p class="error small" id="error" hidden>Wrong password — try again.</p>

  <form method="post" action="/unlock">
    <input type="hidden" name="next" id="next" value="/" />
    <input type="password" name="password" placeholder="Password" required autofocus autocomplete="current-password" />
    <button type="submit">Unlock</button>
  </form>

  <script>
    // Static page: carry ?next= into the form and surface ?error=1.
    const params = new URLSearchParams(location.search);
    const next = params.get('next');
    if (next && next.startsWith('/')) {
      (document.getElementById('next') as HTMLInputElement).value = next;
    }
    if (params.get('error')) {
      document.getElementById('error')!.hidden = false;
    }
  </script>
</BaseLayout>

<style>
  form {
    display: flex;
    gap: 0.5rem;
    max-width: 24rem;
  }

  input[type='password'] {
    flex: 1;
    padding: 0.5rem 0.75rem;
    font: inherit;
    color: var(--fg);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 6px;
  }

  input[type='password']:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  button {
    padding: 0.5rem 1rem;
    font: inherit;
    font-weight: 600;
    color: var(--bg);
    background: var(--fg);
    border: 0;
    border-radius: 6px;
    cursor: pointer;
  }

  .error {
    color: #dc2626;
  }
</style>
