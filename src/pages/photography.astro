---
import BaseLayout from '../layouts/BaseLayout.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { sectionVisibility } from '../site.config';
import type { ImageMetadata } from 'astro';

const noindex = sectionVisibility('/photography') !== 'public';

// Drop photos into src/assets/photos/ and they appear here automatically.
// Filename becomes the alt text (e.g. "golden-gate-at-dusk.jpg").
const modules = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/photos/*.{jpg,jpeg,png,webp,avif}',
  { eager: true }
);

const photos = Object.entries(modules)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([path, mod]) => ({
    image: mod.default,
    alt: (path.split('/').pop() ?? '').replace(/\.[a-z]+$/i, '').replace(/[-_]/g, ' '),
  }));
---

<BaseLayout title="Photography" noindex={noindex} wide>
  <h1>Photography</h1>
  {
    photos.length === 0 ? (
      <p class="muted">No photos yet — add images to <code>src/assets/photos/</code>.</p>
    ) : (
      <PhotoGrid photos={photos} />
    )
  }
</BaseLayout>
