---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: { image: ImageMetadata; alt: string }[];
}

const { photos } = Astro.props;
---

<div class="grid">
  {
    photos.map(({ image, alt }) => (
      <a href={image.src} target="_blank" rel="noopener">
        <Image src={image} alt={alt} widths={[400, 800, 1200]} sizes="(max-width: 40rem) 100vw, 33vw" />
      </a>
    ))
  }
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    gap: 0.75rem;
  }

  .grid a {
    display: block;
    line-height: 0;
  }

  .grid img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 6px;
  }
</style>
