---
// Shown to all visitors while maintenance mode is on (MAINTENANCE_MODE env
// var + middleware.ts rewrite). Standalone on purpose — no site chrome, so
// nothing about the unfinished site leaks.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Brian Yu</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <h1>Brian Yu</h1>
      <p>This site is under construction — check back soon.</p>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: light dark;
  }

  body {
    margin: 0;
    min-height: 100svh;
    display: grid;
    place-items: center;
    font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    background: #fafaf9;
    color: #1c1917;
  }

  @media (prefers-color-scheme: dark) {
    body {
      background: #161514;
      color: #e7e5e4;
    }
  }

  main {
    text-align: center;
    padding: 2rem;
  }

  h1 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 0.5rem;
  }

  p {
    margin: 0;
    color: #78716c;
  }
</style>
